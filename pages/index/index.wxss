.welcome-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.welcome-text {
  display: flex;
  flex-direction: column;
}

.welcome-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text);
}

.welcome-subtitle {
  font-size: 26rpx;
  color: var(--subtext0);
  margin-top: 8rpx;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background-color: var(--blue);
  color: var(--crust);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 600;
}

.stats-grid {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.stat-card {
  flex: 1;
  background-color: var(--surface0);
  border-radius: 16rpx;
  padding: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--blue);
}

.stat-label {
  font-size: 24rpx;
  color: var(--subtext0);
  margin-top: 8rpx;
}

.quick-actions {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  background-color: var(--surface1);
  border-radius: 16rpx;
  padding: 30rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.action-btn:active {
  opacity: 0.7;
}

.action-icon {
  font-size: 48rpx;
}

.action-text {
  font-size: 26rpx;
  color: var(--subtext1);
}

.match-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.match-item {
  background-color: var(--surface1);
  border-radius: 12rpx;
  padding: 24rpx;
}

.match-item:active {
  opacity: 0.7;
}

.match-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.match-info {
  display: flex;
  flex-direction: column;
}

.match-company {
  font-size: 24rpx;
  color: var(--subtext0);
}

.match-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  margin-top: 4rpx;
}

.match-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}
