.filter-bar {
  white-space: nowrap;
  margin-bottom: 24rpx;
  display: flex;
  gap: 12rpx;
}

.filter-item {
  display: inline-flex;
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: var(--subtext0);
  background-color: var(--surface0);
  margin-right: 12rpx;
}

.filter-active {
  background-color: var(--blue);
  color: var(--crust);
  font-weight: 500;
}

.stats-grid {
  display: flex;
  gap: 20rpx;
}

.stat-card {
  flex: 1;
  background-color: var(--surface0);
  border-radius: 16rpx;
  padding: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
}

.stat-label {
  font-size: 24rpx;
  color: var(--subtext0);
  margin-top: 8rpx;
}

.match-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.match-card {
  background-color: var(--surface0);
  border-radius: 16rpx;
  padding: 28rpx;
}

.match-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.match-info {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.match-company {
  font-size: 24rpx;
  color: var(--subtext0);
}

.match-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  margin-top: 4rpx;
}

.match-score-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.match-card {
  background-color: var(--surface0);
  border-radius: 16rpx;
  padding: 28rpx;
}
