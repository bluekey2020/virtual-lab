/* Catppuccin Mocha 主题配色 */
:root {
  --base: #1e1e2e;
  --mantle: #181825;
  --crust: #11111b;
  --text: #cdd6f4;
  --subtext1: #bac2de;
  --subtext0: #a6adc8;
  --overlay2: #9399b2;
  --overlay1: #7f849c;
  --overlay0: #6c7086;
  --surface2: #585b70;
  --surface1: #45475a;
  --surface0: #313244;
  --blue: #89b4fa;
  --lavender: #b4befe;
  --sapphire: #74c7ec;
  --sky: #89dceb;
  --teal: #94e2d5;
  --green: #a6e3a1;
  --yellow: #f9e2af;
  --peach: #fab387;
  --maroon: #eba0ac;
  --red: #f38ba8;
  --mauve: #cba6f7;
  --pink: #f5c2e7;
  --flamingo: #f2cdcd;
  --rosewater: #f5e0dc;
}

page {
  background-color: var(--base);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

.container {
  padding: 30rpx;
}

.card {
  background-color: var(--surface0);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}

.card-title-icon {
  margin-right: 12rpx;
  font-size: 36rpx;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 40rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
}

.btn-primary {
  background-color: var(--blue);
  color: var(--crust);
}

.btn-primary:active {
  opacity: 0.8;
}

.btn-secondary {
  background-color: var(--surface1);
  color: var(--text);
}

.btn-secondary:active {
  opacity: 0.8;
}

.btn-success {
  background-color: var(--green);
  color: var(--crust);
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}

.tag-blue {
  background-color: rgba(137, 180, 250, 0.2);
  color: var(--blue);
}

.tag-green {
  background-color: rgba(166, 227, 161, 0.2);
  color: var(--green);
}

.tag-yellow {
  background-color: rgba(249, 226, 175, 0.2);
  color: var(--yellow);
}

.tag-peach {
  background-color: rgba(250, 179, 135, 0.2);
  color: var(--peach);
}

.tag-red {
  background-color: rgba(243, 139, 168, 0.2);
  color: var(--red);
}

.tag-mauve {
  background-color: rgba(203, 166, 247, 0.2);
  color: var(--mauve);
}

.score-circle {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 700;
}

.score-high {
  background-color: rgba(166, 227, 161, 0.2);
  color: var(--green);
  border: 4rpx solid var(--green);
}

.score-mid {
  background-color: rgba(249, 226, 175, 0.2);
  color: var(--yellow);
  border: 4rpx solid var(--yellow);
}

.score-low {
  background-color: rgba(243, 139, 168, 0.2);
  color: var(--red);
  border: 4rpx solid var(--red);
}

.input {
  background-color: var(--surface1);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  color: var(--text);
  font-size: 28rpx;
  margin-bottom: 20rpx;
}

.input::placeholder {
  color: var(--overlay0);
}

.textarea {
  background-color: var(--surface1);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  color: var(--text);
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
  min-height: 200rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--subtext1);
  margin: 30rpx 0 16rpx 0;
  padding-left: 16rpx;
  border-left: 6rpx solid var(--blue);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  color: var(--overlay0);
  text-align: center;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.flex {
  display: flex;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-wrap {
  display: flex;
  flex-wrap: wrap;
}

.text-blue { color: var(--blue); }
.text-green { color: var(--green); }
.text-yellow { color: var(--yellow); }
.text-peach { color: var(--peach); }
.text-red { color: var(--red); }
.text-mauve { color: var(--mauve); }
.text-subtext { color: var(--subtext0); }
.text-small { font-size: 24rpx; }
.text-large { font-size: 36rpx; }

.mt-2 { margin-top: 16rpx; }
.mt-3 { margin-top: 24rpx; }
.mb-2 { margin-bottom: 16rpx; }
.mb-3 { margin-bottom: 24rpx; }

.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 12rpx;
  border-radius: 18rpx;
  font-size: 22rpx;
  background-color: var(--red);
  color: white;
}

/* 匹配度进度条（共用） */
.match-bar-item {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.match-bar-label {
  width: 140rpx;
  font-size: 26rpx;
  color: var(--subtext0);
  flex-shrink: 0;
}

.match-bar-track {
  flex: 1;
  height: 16rpx;
  background-color: var(--surface1);
  border-radius: 8rpx;
  overflow: hidden;
  margin: 0 16rpx;
}

.match-bar-fill {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

.fill-high {
  background-color: var(--green);
}

.fill-mid {
  background-color: var(--yellow);
}

.fill-low {
  background-color: var(--red);
}

.match-bar-score {
  width: 60rpx;
  text-align: right;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
  flex-shrink: 0;
}
